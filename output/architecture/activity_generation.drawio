<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="activity_generation"><mxGraphModel pageWidth="471" pageHeight="1181"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="" style="ellipse;fillColor=#000000;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="144.37" y="19.999999999999954" width="3.6" height="3.6" as="geometry"/></mxCell><mxCell id="n1" value="Задать период, бюджет, предпочтения&#xa;Нажать «Составить меню»" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="29.745999999999995" y="56.560119999999955" width="232.848" height="48.47976" as="geometry"/></mxCell><mxCell id="n2" value="POST /api/plan&#xa;Проверить сессию и готовый профиль" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="31.369600000000005" y="138.08011999999994" width="229.6008" height="48.47976" as="geometry"/></mxCell><mxCell id="n3" value="Ввод допустим?" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="37.55080000000001" y="219.56011999999993" width="217.23839999999998" height="65.75976" as="geometry"/></mxCell><mxCell id="n4" value="Показать 401 или 422&#xa;Предыдущий план не менять" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20.00099999999999" y="395.00012000000004" width="174.348" height="48.47976" as="geometry"/></mxCell><mxCell id="n5" value="Объединить профиль с параметрами&#xa;Рассчитать целевую энергию и БЖУ" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="163.24399999999997" y="330.52012" width="219.852" height="48.47976" as="geometry"/></mxCell><mxCell id="n6" value="Для каждого дня и приёма&#xa;учесть состав, время и повторы" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="176.99640000000002" y="459.48011999999994" width="200.3472" height="48.47976" as="geometry"/></mxCell><mxCell id="n7" value="Все позиции подобраны?" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="121.7996" y="540.96012" width="314.74080000000004" height="65.75976" as="geometry"/></mxCell><mxCell id="n8" value="Ответить 422&#xa;Сохранить прежний план" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="102.12119999999999" y="716.4001199999999" width="158.0976" height="48.47976" as="geometry"/></mxCell><mxCell id="n9" value="Масштабировать порции&#xa;по энергетической доле приёма" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="218.99640000000002" y="651.92012" width="200.3472" height="48.47976" as="geometry"/></mxCell><mxCell id="n10" value="Одной транзакцией записать&#xa;Plan draft и все Meal" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="227.1216" y="780.8801199999999" width="184.0968" height="48.47976" as="geometry"/></mxCell><mxCell id="n11" value="Суммировать продукты, вычесть запасы&#xa;Рассчитать упаковки и полные корзины" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=13;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="197.8716" y="862.3601199999999" width="242.5968" height="48.47976" as="geometry"/></mxCell><mxCell id="n12" value="HTTP 201: снимок состояния&#xa;Меню, калории, цены и бюджет" style="rounded=1;whiteSpace=wrap