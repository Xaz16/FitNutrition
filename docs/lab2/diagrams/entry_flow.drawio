<mxfile host="app.diagrams.net"><diagram name="Fit Nutrition Supply: поток входа"><mxGraphModel pageWidth="1220" pageHeight="600"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Регистрация&#10;Имя, email, пароль" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=14;fillColor=white;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="110" width="220" height="85" /></mxCell><mxCell id="n2" value="Обязательный профиль&#10;3 шага + сводка" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=14;fillColor=white;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="110" width="220" height="85" /></mxCell><mxCell id="n3" value="Дашборд&#10;Приветствие и профиль" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=14;fillColor=white;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="110" width="220" height="85" /></mxCell><mxCell id="n4" value="Настройте ваш план&#10;Меню + расчёт корзины" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=14;fillColor=white;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="110" width="220" height="85" /></mxCell><mxCell id="n5" value="Повторный вход" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=14;fillColor=white;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="350" width="220" height="70" /></mxCell><mxCell id="n6" value="Профиль&#10;сохранён?" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=14;fillColor=white;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="320" width="220" height="130" /></mxCell><mxCell id="n7" value="Прямой переход к плану&#10;без профиля запрещён&#10;в интерфейсе и в API" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=14;fillColor=whit