digraph {
	graph [bb="0 0 653 1057",
		bgcolor=white,
		nodesep=0.35,
		pad=0.2,
		rankdir=TB,
		ranksep=0.45,
		splines=polyline
	];
	node [color=black,
		fontname="Times New Roman",
		fontsize=13,
		label="\N",
		margin="0.15,0.12",
		style=solid
	];
	edge [arrowsize=0.65,
		fontname="Times New Roman",
		fontsize=11
	];
	start	[label="",
		shape=point];
	open	[label="Нажать «Заменить» у блюда",
		shape=box,
		style=rounded];
	start -> open;
	filter	[label="Отфильтровать: тип приёма, аллергии,
предпочтения, время, повторы,
калории \
в пределах ±15%",
		shape=box,
		style=rounded];
	open -> filter;
	exists	[label="Есть варианты?",
		shape=diamond];
	filter -> exists;
	none	[label="Показать отсутствие альтернатив
План не изменять",
		shape=box,
		style=rounded];
	exists -> none	[label="[нет]"];
	preview	[label="Для каждого варианта пересчитать
список, запасы и целые упаковки",
		shape=box,
		style=rounded];
	exists -> preview	[label="[да]"];
	end	[label="",
		shape=doublecircle];
	none -> end;
	show	[label="Показать название, калории
и разницу полной корзины",
		shape=box,
		style=rounded];
	preview -> show;
	choose	[label="Вариант выбран?",
		shape=diamond];
	show -> choose;
	cancel	[label="Закрыть без изменений",
		shape=box,
		style=rounded];
	choose -> cancel	[label="[нет]"];
	version	[label="Версия плана актуальна?",
		shape=diamond];
	choose -> version	[label="[да]"];
	cancel -> end;
	conflict	[label="Показать 409
Запросить свежий результат",
		shape=box,
		style=rounded];
	version -> conflict	[label="[нет]"];
	write	[label="Повторить проверку ограничений
Заменить одну позицию транзакцией",
		shape=box,
		style=rounded];
	version -> write	[label="[да]"];
	conflict -> filter;
	recalc	[label="Пересчитать меню и корзины
Отметить план черновиком",
		shape=box,
		style=rounded];
	write -> recalc;
	ui	[label="Обновить блюда, сумму и бюджет
без перезагрузки страницы",
		shape=box,
		style=rounded];
	recalc -> ui;
	ui -> end;
}
