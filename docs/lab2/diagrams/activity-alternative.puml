@startuml activity-alternative
title Активность 2. Альтернативный сценарий: превышение бюджета и замена блюда
skinparam defaultFontName Arial
skinparam shadowing false

|Пользователь|
start
:Открыть сравнение корзин;
|Система|
:Рассчитать корзины и прогноз;
if (Прогноз > бюджета?) then (нет)
  |Пользователь|
  :Принять рекомендуемую корзину;
  stop
else (да)
  |Система|
  :Показать «Превышение бюджета на N ₽»;
endif
|Пользователь|
if (Что сделать?) then (заменить блюдо)
  :Открыть рацион и нажать «Заменить»\nу дорогого блюда;
  |Система|
  :Подобрать блюда того же приёма пищи\nв пределах ±15 % калорий\nбез исключённых продуктов;
  if (Есть альтернативы?) then (да)
    |Пользователь|
    if (Выбрать блюдо?) then (да)
      :Выбрать альтернативу;
      |Система|
      :Заменить только выбранную позицию;
      :Пересчитать порции под ту же калорийность;
      :Сбросить кэш списка покупок и корзин;
    else (отмена)
      |Система|
      :Оставить рацион без изменений;
    endif
  else (нет)
    |Система|
    :Сообщить, что подходящих замен нет;
  endif
else (изменить бюджет)
  |Пользователь|
  :Ввести новый бюджет;
  |Система|
  if (Бюджет > 0 и число?) then (да)
    :Сохранить бюджет рациона;
  else (нет)
    :Показать ошибку у поля «Бюджет»;
  endif
endif
|Система|
:Пересчитать корзины и прогноз;
|Пользователь|
:Увидеть обновлённый прогноз;
stop
@enduml
